# SIH26186 Personnel Welfare System Environment Configuration
# Copy this file to .env and adjust variables as needed for deployment.

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Session Authentication Secret
JWT_SECRET=sih26186_personnel_welfare_secure_jwt_secret_2026

# Admin Role Bootstrap / Registration Key
# Non-PERSONNEL registration requires this secret or an authenticated ADMIN session
ADMIN_REGISTRATION_SECRET=welfare-secure-admin-key-2026

# Database Connection (MongoDB URI)
MONGODB_URI=mongodb://127.0.0.1:27017/personnel_welfare

# Machine Learning Service (FastAPI) URL
ML_SERVICE_URL=http://127.0.0.1:8000

# CORS Allowed Origins (Comma-separated list)
CORS_ORIGIN=http://localhost:5000,http://127.0.0.1:5000,http://localhost:8000,http://127.0.0.1:8000
